# Configuração local do deploy. Copie para deploy/deploy.conf e ajuste.
#
#   cp deploy/deploy.conf.example deploy/deploy.conf
#
# O deploy.conf não vai para o git (está no .gitignore). O formato
# "${VAR:-valor}" mantém a precedência das variáveis de ambiente:
# VPS_IP=outro-ip make deploy continua funcionando.

VPS_IP="${VPS_IP:-}"
VPS_USER="${VPS_USER:-root}"
PROJECT_DIR="${PROJECT_DIR:-/home/portfolio_davi_oliveira}"
BRANCH="${BRANCH:-main}"
SERVICE_NAME="${SERVICE_NAME:-portfolio}"
# Só exibida na mensagem final do deploy — o domínio real do site vem do
# SITE_URL configurado no .env da VPS (veja docs/MIGRACAO_DOMINIO.md).
SITE_URL="${SITE_URL:-https://davioliveira.tech}"
